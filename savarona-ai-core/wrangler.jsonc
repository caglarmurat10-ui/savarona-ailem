{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savarona-ai-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "vars": {
    "APP_ENV": "production",
    "OPENAI_MODEL": "",
    "ANTHROPIC_MODEL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "savarona-ai-core",
      "database_id": "ffc99cd3-c2d4-49ca-925d-54d10607c9a2"
    }
  ],
  "observability": {
    "enabled": true
  }
}
