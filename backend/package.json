{
  "name": "savarona-ailem-api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply savarona-ailem --local",
    "db:remote": "wrangler d1 migrations apply savarona-ailem --remote",
    "check": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.130.0"
  }
}
